<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.chrisporat.screencap-process</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/chrisporat/.local/bin/uv</string>
    <string>run</string>
    <string>/Users/chrisporat/Development/personal/screencap/process.py</string>
    <string>--batch-size</string>
